###############################################################################
# TropaTT — Environment Configuration Example
#
# Copy this file to .env and fill in your values:
#   cp api/.env.example api/.env
#
# All variables are OPTIONAL unless marked as REQUIRED.
# Most variables have sensible defaults — only override what you need.
#
# For production, ALL security keys MUST be set explicitly.
###############################################################################

# ─── Application ───────────────────────────────────────────────────────────────

# Environment: prod, production, dev, staging, test
# Production enforces all security keys and disables debug mode.
# APP_ENV=prod

# Set to 1 to enable debug mode (only works in non-production environments)
# APP_DEBUG=0

# Default timezone (PHP timezone format)
# APP_TIMEZONE=Europe/Moscow

# Application key — REQUIRED for production.
# Used for token signing, encryption, and session integrity.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# APP_KEY=

# CORS allowed origins for browser API access.
# In development defaults to localhost. In production MUST be set to your domain.
# Separate multiple origins with commas.
# CORS_ALLOW_ORIGIN=https://crm.example.com

# Session cookie name (default: crm_api_session)
# CRM_API_SESSION_COOKIE=crm_api_session


# ─── Database ─────────────────────────────────────────────────────────────────

# Database driver: mysql, sqlite, pgsql, sqlsrv (default: mysql)
# DB_CONNECTION=mysql

# MySQL/MariaDB connection
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=crm
# DB_USERNAME=root
# DB_PASSWORD=                      # REQUIRED in production
# DB_CHARSET=utf8mb4
# DB_PREFIX=

# Alternative MySQL env names (legacy support)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=crm
# MYSQL_USER=root
# MYSQL_PASSWORD=

# PostgreSQL connection (when DB_CONNECTION=pgsql)
# DB_PORT=5432

# SQLite database path (when DB_CONNECTION=sqlite)
# CRM_SQLITE_DATABASE=/var/www/storage_api/temp/crm.sqlite


# ─── Storage ───────────────────────────────────────────────────────────────────

# Base path for all storage directories (uploads, logs, sessions, cache, etc.)
# Default: <project-root>/storage_api
# CRM_STORAGE_BASE=/var/www/storage_api


# ─── Security Keys — REQUIRED in production ────────────────────────────────────

# CSRF secret key — used for cookie-based CSRF token generation.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# CSRF_SECRET_KEY=

# Webhook signing secret — used to sign outgoing webhook payloads.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# WEBHOOK_SECRET_KEY=

# AI encryption key — used to encrypt AI provider API keys at rest.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# AI_ENCRYPTION_KEY=

# In non-production environments, missing keys are auto-generated with a warning.
# In production, missing keys cause a fatal error.


# ─── Auth Token Lifetimes ─────────────────────────────────────────────────────

# Access token TTL in seconds (default: 3 days = 259200)
# CRM_AUTH_ACCESS_TOKEN_TTL=259200
# AUTH_ACCESS_TOKEN_TTL=259200

# Refresh token TTL in seconds (default: 14 days = 1209600)
# CRM_AUTH_REFRESH_TOKEN_TTL=1209600
# AUTH_REFRESH_TOKEN_TTL=1209600

# Maximum session lifetime in seconds (default: 30 days = 2592000)
# CRM_AUTH_MAX_SESSION_LIFETIME=2592000


# ─── Push Notifications (Web Push / VAPID) ─────────────────────────────────────

# Web Push gateway URL (e.g., https://updates.push.services.mozilla.com/wpush/v1)
# NOTIFICATIONS_PUSH_GATEWAY_URL=

# VAPID keys — required for Web Push notifications.
# Generate with: npx web-push generate-vapid-keys
# NOTIFICATIONS_PUSH_VAPID_PUBLIC_KEY=
# NOTIFICATIONS_PUSH_VAPID_PRIVATE_KEY=

# VAPID subject (mailto: or https:// contact)
# NOTIFICATIONS_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# HTTP timeout for push dispatch (seconds, default: 5)
# NOTIFICATIONS_PUSH_TIMEOUT_SEC=5

# Max subscriptions per dispatch batch (default: 100)
# NOTIFICATIONS_PUSH_MAX_SUBSCRIPTIONS_PER_DISPATCH=100


# ─── API File Cache ───────────────────────────────────────────────────────────

# Enable file-based API response caching (default: false)
# API_FILE_CACHE_ENABLED=false

# Default cache TTL in seconds (default: 60)
# API_FILE_CACHE_TTL=60

# Enable cache debug logging (default: false)
# API_FILE_CACHE_DEBUG=false

# Enable garbage collection (default: true)
# API_FILE_CACHE_GC_ENABLED=true

# GC probability 1/N (default: 1 = every request)
# API_FILE_CACHE_GC_PROBABILITY=1

# Max cache file age before GC removes it (seconds, default: 86400 = 1 day)
# API_FILE_CACHE_GC_MAX_AGE=86400

# Max files to remove per GC run (default: 100)
# API_FILE_CACHE_GC_LIMIT=100


# ─── Web UI ───────────────────────────────────────────────────────────────────

# Assets version string for cache busting (e.g., git hash)
# CRM_WEB_ASSETS_VERSION=

# Real-time transport: polling, sse, or empty (default: empty)
# CRM_REALTIME_TRANSPORT=sse

# Cron secret key — protects web/cron.php endpoint
# CRON_SECRET_KEY=


# ─── Updates ──────────────────────────────────────────────────────────────────

# Update channel: stable, beta, dev (default: stable)
# TROPATT_UPDATE_CHANNEL=stable

# Update center URL (default: https://update.tropatt.com)
# TROPATT_UPDATE_CENTER_URL=https://update.tropatt.com

# Optional legacy HTTP fallback URL for the local updater.
# Normal installations must leave this empty: the API invokes updater in-process
# and does not call the site's own public hostname. Set only to an explicitly
# trusted local updater base URL for an unusual legacy deployment.
# TROPATT_LOCAL_UPDATER_URL=


# ─── Installer ────────────────────────────────────────────────────────────────

# Bootstrap secret — used during initial installation via API.
# INSTALL_BOOTSTRAP_SECRET=


# ─── Modules ──────────────────────────────────────────────────────────────────

# Signing key for module package verification.
# MODULE_SIGNING_KEY=

# Legacy app secret for module encryption (modules only)
# APP_SECRET=


# ─── Seed / Test Scripts ─────────────────────────────────────────────────────

# API base URL for seed scripts
# CRM_SEED_API_BASE=http://localhost/api/index.php

# Database connection for seed scripts
# CRM_SEED_DB_DSN=mysql:host=localhost;port=3306;dbname=local;charset=utf8mb4
# CRM_SEED_DB_USER=local
# CRM_SEED_DB_PASSWORD=
# CRM_SEED_ROOT_LOGIN=root
# CRM_SEED_ROOT_PASSWORD=
# CRM_SEED_ROOT_TOKEN=

# Test runner credentials (aliases for seed scripts)
# CRM_TEST_ROOT_LOGIN=root
# CRM_TEST_ROOT_PASSWORD=
# CRM_TEST_ROOT_TOKEN=

# AI cron authentication
# CRM_AI_CRON_BEARER_TOKEN=
# CRM_AI_CRON_LOGIN=
# CRM_AI_CRON_PASSWORD=
# CRM_AI_CRON_TOTP=

# Allow mock AI provider runtime (dangerous in production)
# CRM_AI_ALLOW_MOCK_RUNTIME=false

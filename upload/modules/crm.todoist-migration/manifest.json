{
    "name": "crm.todoist-migration",
    "version": "1.0.0",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Миграция из Todoist",
    "description": "Односторонняя миграция проектов, секций, задач и связанных данных из Todoist в TropaTT",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "migration",
    "dependencies": [],
    "require_permissions": ["project.manage", "task.manage", "import.manage"],
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "migrations": "api/migration/",
    "assets": {
        "js_routes": {"module-todoist-migration": "web/assets/js/todoist-migration.js"},
        "css": ["web/assets/css/todoist-migration.css"]
    },
    "hooks": {},
    "menu_items": [],
    "service_provider": "Module\\Crm\\TodoistMigration\\TodoistMigrationServiceProvider",
    "config_defaults": {
        "request_timeout_seconds": 60,
        "max_retries": 4,
        "default_batch_size": 100,
        "max_attachment_size_mb": 20,
        "include_completed_by_default": false,
        "include_archived_by_default": false,
        "include_comments_by_default": true,
        "include_attachments_by_default": false,
        "max_tasks_per_job": 0
    }
}

{
    "name": "crm.jira-migration",
    "version": "1.0.0",
    "vendor": "crm",
    "title": "Миграция из Jira",
    "description": "Модуль миграции проектов, задач, спринтов, комментариев, вложений и метаданных из Jira Cloud в проекты и задачи TropaTT CRM",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "dependencies": [],
    "require_permissions": ["project.manage", "task.manage", "task.manage_settings"],
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "migrations": "api/migration/",
    "assets": {
        "js_routes": {
            "module-jira-migration": "web/assets/js/module-jira-migration.js"
        },
        "css": ["web/assets/css/module-jira-migration.css"]
    },
    "hooks": {},
    "menu_items": [],
    "service_provider": "Module\\Crm\\JiraMigration\\JiraMigrationServiceProvider",
    "config_defaults": {
        "max_attachment_size_mb": 20,
        "allowed_jira_hosts": ["*.atlassian.net"],
        "custom_domain_allowlist": [],
        "default_batch_size": 100,
        "request_timeout_seconds": 60,
        "max_retries": 3,
        "dry_run_sample_limit": 200,
        "jql_default_max_results": 100,
        "import_issue_limit": 0,
        "worklog_batch_size": 50,
        "attachment_download_timeout": 120
    }
}

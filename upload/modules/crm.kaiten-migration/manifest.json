{
  "name": "crm.kaiten-migration",
  "version": "1.0.0",
  "vendor": "crm",
  "title": "Миграция из Kaiten",
  "description": "Миграция пространств, досок, колонок, карточек и связанных данных из Kaiten в TropaTT CRM",
  "core_version": ">=1.0.0",
  "license": "MIT",
  "dependencies": [],
  "require_permissions": ["project.manage", "task.manage", "import.manage"],
  "api_routes": "api/config/routes.php",
  "web_routes": "web/config/routes.php",
  "migrations": "api/migration/",
  "assets": {"js_routes": {"module-kaiten-migration": "web/assets/js/kaiten-migration.js"}, "css": ["web/assets/css/kaiten-migration.css"]},
  "hooks": {},
  "menu_items": [],
  "service_provider": "Module\\Crm\\KaitenMigration\\KaitenMigrationServiceProvider",
  "config_defaults": {
    "request_timeout_seconds": 60,
    "max_retries": 4,
    "default_page_size": 100,
    "max_collection_items": 10000,
    "max_attachment_size_mb": 20,
    "include_archived_by_default": false,
    "include_comments_by_default": true,
    "include_attachments_by_default": false,
    "include_history_by_default": false
  }
}

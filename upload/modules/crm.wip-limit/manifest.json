{
    "name": "crm.wip-limit",
    "version": "1.2.0",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "WIP Limit",
    "description": "Ограничение количества задач в работе (Work In Progress). Живой подсчёт WIP-нагрузки по пользователям, индивидуальные лимиты и контроль превышения.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "productivity",
    "dependencies": [],
    "require_permissions": [],
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "migrations": "api/migrations/",
    "assets": {
        "css_routes": {"task-detail": "web/assets/css/module-wip-limit.css"},
        "js_routes": {"task-detail": "web/assets/js/wip-task-sidebar.js"}
    },
    "positions": {
        "task.detail.sidebar": [
            {"renderer": "Module\\Crm\\WipLimit\\Position\\TaskSidebarPanel::render", "priority": 10}
        ]
    },
    "hooks": {},
    "menu_items": [],
    "service_provider": "Module\\Crm\\WipLimit\\WipLimitServiceProvider",
    "config_defaults": {
        "default_limit": 5,
        "enforce_on_status": ["in_progress", "review"],
        "notify_on_exceed": true,
        "excluded_role_ids": []
    }
}

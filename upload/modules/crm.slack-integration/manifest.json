{
    "name": "crm.slack-integration",
    "version": "1.1.0",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Уведомления в Slack",
    "description": "Отправка уведомлений TropaTT в Slack-каналы через Incoming Webhooks. Подписывается на события ядра (задачи, проекты, пользователи, комментарии, файлы) и автоматически шлёт уведомления по правилам.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": ["workflow.manage"],
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "migrations": "api/migration/",
    "assets": {
        "js_routes": {
            "module-slack-integration": "web/assets/js/slack.js"
        },
        "css": ["web/assets/css/slack.css"]
    },
    "hooks": {},
    "menu_items": [],
    "service_provider": "Module\\Crm\\SlackIntegration\\SlackServiceProvider",
    "config_defaults": {
        "request_timeout_seconds": 10,
        "max_retries": 3,
        "retry_backoff_seconds": 30,
        "allowed_webhook_hosts": ["hooks.slack.com"]
    }
}

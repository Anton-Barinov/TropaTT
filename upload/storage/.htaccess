# SEC-001: Block all direct access to storage directory
# Apache 2.4+ compatibility
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 compatibility
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php|phtml|phar|inc|cgi|pl|py|sh|bash|exe)$">
    Order allow,deny
    Deny from all
</FilesMatch>

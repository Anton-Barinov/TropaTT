    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "project.manage",
        "task.manage"
    ],
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "migrations": "api/migration/",
    "assets": {
        "js_routes": {
            "module-gitlab-integration": "web/assets/js/gitlab.js"
        },
        "css": [
            "web/assets/css/gitlab.css"
        ]
    },
    "hooks": [],

    "config_defaults": {
        "request_timeout_seconds": 30,
        "max_retries": 3,
        "batch_size": 100,
        "default_base_url": "https://gitlab.com/api/v4",
        "allowed_api_hosts": ["gitlab.com"],
        "sync_comments": true,
        "poll_interval_minutes": 15,
        "push_back_comments": true,
        "push_back_status": true

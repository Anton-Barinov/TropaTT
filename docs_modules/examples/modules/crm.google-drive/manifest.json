{
    "name": "crm.google-drive",
    "version": "1.0.6",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Интеграция с Google Диском",
    "description": "Подключение Google Drive через OAuth refresh token, проверка аккаунта и ручная приватная передача доступных файлов CRM.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit",
        "files.view",
        "files.create"
    ],
    "service_provider": "Module\\Crm\\GoogleDrive\\GoogleDriveServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "google-drive-storage",
            "title": "Google Диск",
            "route": "google-drive",
            "icon": "google",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/google-drive.css"
        ],
        "js_routes": {
            "module-google-drive": "web/assets/js/google-drive.js"
        }
    },
    "mcp_tools": [
        {
            "name": "google_drive_status",
            "description": "Check Google Drive configuration for the active workspace without revealing OAuth secrets.",
            "handler": "Module\\Crm\\GoogleDrive\\Mcp\\DriveStatusTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "google_drive_attach_file",
            "description": "Upload an authorized, non-quarantined CRM file to the active workspace Google Drive account. The file remains private.",
            "handler": "Module\\Crm\\GoogleDrive\\Mcp\\AttachFileTool",
            "permissions": [
                "files.view",
                "files.create"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "file_public_id": {
                        "type": "string",
                        "description": "Public ID of the CRM file to upload"
                    }
                },
                "required": [
                    "file_public_id"
                ],
                "additionalProperties": false
            }
        }
    ]
}

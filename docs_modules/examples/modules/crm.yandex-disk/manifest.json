{
    "name": "crm.yandex-disk",
    "version": "1.0.3",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Интеграция с Яндекс Диском",
    "description": "Заготовка интеграции с Яндекс Диском. Загрузка и публикация ссылок отключены, пока не реализован безопасный обмен файлами.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit",
        "files.view",
        "files.create"
    ],
    "service_provider": "Module\\Crm\\YandexDisk\\YandexDiskServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "yandex-disk",
            "title": "Яндекс Диск",
            "route": "yandex-disk",
            "icon": "cloud-arrow-up",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/yandex-disk.css"
        ],
        "js_routes": {
            "module-yandex-disk": "web/assets/js/yandex-disk.js"
        }
    },
    "mcp_tools": [
        {
            "name": "yandex_disk_status",
            "description": "Get current connection status and available space on Yandex Disk",
            "handler": "Module\\Crm\\YandexDisk\\Mcp\\DiskStatusTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "yandex_disk_upload_file",
            "description": "Upload a CRM file to Yandex Disk. Currently unavailable until secure provider transfer is implemented.",
            "handler": "Module\\Crm\\YandexDisk\\Mcp\\UploadFileTool",
            "permissions": [
                "files.create"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "file_public_id": {
                        "type": "string",
                        "description": "Public ID of local CRM file (fil_...)"
                    },
                    "target_path": {
                        "type": "string",
                        "description": "Target folder on Yandex Disk (e.g. /TropaTT_CRM/Tasks)"
                    },
                    "make_public": {
                        "type": "boolean",
                        "default": false,
                        "description": "Reserved for a future explicit sharing flow; files must remain private by default."
                    }
                },
                "required": [
                    "file_public_id"
                ],
                "additionalProperties": false
            }
        }
    ]
}

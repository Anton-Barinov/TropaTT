{
    "name": "crm.whatsapp-business",
    "version": "1.1.1",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "WhatsApp Business Platform",
    "description": "Workspace-scoped WhatsApp Cloud API inbox with signed Meta webhooks, CRM Intake linkage, secure credentials and 24-hour text replies.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit"
    ],
    "service_provider": "Module\\Crm\\WhatsAppBusiness\\WhatsAppBusinessServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "whatsapp-inbox",
            "title": "WhatsApp Inbox",
            "route": "module-whatsapp-business",
            "icon": "chat-dots",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/whatsapp.css"
        ],
        "js_routes": {
            "module-whatsapp-business": "web/assets/js/whatsapp.js"
        }
    },
    "mcp_tools": [
        {
            "name": "whatsapp_list_inbox",
            "description": "List WhatsApp customer conversations in team inbox",
            "handler": "Module\\Crm\\WhatsAppBusiness\\Mcp\\ListInboxTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        }
    ]
}

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="tropatt" translate="label" sortOrder="400">
            <label>TropaTT CRM</label>
        </tab>
        <section id="tropatt" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>TropaTT CRM — e-commerce gateway</label>
            <tab>tropatt</tab>
            <resource>Tropatt_Crm::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="gateway_url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>TropaTT gateway URL</label>
                    <comment>https://crm.example.com/api/index.php?route=/_module/crm.ecommerce-gateway/v1</comment>
                </field>
                <field id="store_key" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store public key (stk_...)</label>
                </field>
                <field id="store_secret" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store secret</label>
                </field>
                <field id="webhook_secret" translate="label" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook secret</label>
                </field>
                <field id="default_stage" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default CRM stage</label>
                </field>
                <field id="status_mapping" translate="label" type="textarea" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Status mapping (Magento status = CRM stage)</label>
                </field>
                <field id="source_code" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Inventory source code (MSI)</label>
                    <comment>default</comment>
                </field>
            </group>
        </section>
    </system>
</config>

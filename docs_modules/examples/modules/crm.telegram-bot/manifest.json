{
    "name": "crm.telegram-bot",
    "version": "1.0.10",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Telegram Bot Integration",
    "description": "Telegram бот для входящих заявок клиентов, обращений в Intake и персональных уведомлений сотрудников команды",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit"
    ],
    "service_provider": "Module\\Crm\\TelegramBot\\TelegramBotServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "config_defaults": {
        "use_env_token": true,
        "bot_token": "",
        "bot_username": "",
        "webhook_secret_token": "",
        "auto_create_intake": true,
        "welcome_message": "Здравствуйте! Я официальный бот TropaTT CRM. Напишите ваш вопрос или заявку, и наша команда свяжется с вами.",
        "polling_enabled": false
    },
    "menu_items": [
        {
            "id": "telegram-bot",
            "title": "Telegram Бот",
            "route": "module-telegram-bot",
            "icon": "send",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/telegram-bot.css"
        ],
        "js_routes": {
            "module-telegram-bot": "web/assets/js/telegram-bot.js"
        }
    },
    "mcp_tools": [
        {
            "name": "telegram_status",
            "description": "Get Telegram bot operational status and configuration check",
            "handler": "Module\\Crm\\TelegramBot\\Mcp\\BotStatusTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        }
    ]
}

{
    "name": "crm.hubspot-migration",
    "version": "1.1.0",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "HubSpot Data Migration",
    "description": "Импорт контактов из вставленного JSON-экспорта HubSpot с предпросмотром, пакетной обработкой, изоляцией по рабочему пространству и безопасным откатом.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integrations",
    "dependencies": [],
    "require_permissions": [
        "client.view",
        "client.manage"
    ],
    "service_provider": "Module\\Crm\\HubSpotMigration\\HubSpotMigrationServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "hubspot-migration",
            "title": "Импорт из HubSpot",
            "route": "hubspot-migration",
            "icon": "upload-cloud",
            "permission": "client.manage"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/hubspot-migration.css"
        ],
        "js_routes": {
            "module-hubspot-migration": "web/assets/js/hubspot-migration.js"
        }
    },
    "mcp_tools": [
        {
            "name": "hubspot_migration_status",
            "description": "Show migration sessions and supported HubSpot export scope for the active workspace",
            "handler": "Module\\Crm\\HubSpotMigration\\Mcp\\MigrationStatusTool",
            "permissions": [
                "client.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "hubspot_migration_run",
            "description": "Run one bounded import batch or safe rollback for an existing HubSpot contacts migration session",
            "handler": "Module\\Crm\\HubSpotMigration\\Mcp\\MigrationRunTool",
            "permissions": [
                "client.manage"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "operation": {
                        "type": "string",
                        "enum": [
                            "import_batch",
                            "rollback"
                        ]
                    },
                    "session_id": {
                        "type": "string",
                        "pattern": "^hsm_[a-f0-9]{32}$"
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 25
                    }
                },
                "required": [
                    "operation",
                    "session_id"
                ],
                "additionalProperties": false
            }
        }
    ]
}

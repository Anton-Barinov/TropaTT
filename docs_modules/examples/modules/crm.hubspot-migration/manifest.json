{
    "name": "crm.hubspot-migration",
    "version": "1.0.0",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "HubSpot Data Migration",
    "description": "Безопасный перенос контактов, компаний, сделок и заметок из HubSpot в TropaTT CRM с предпросмотром, дедупликацией и аудитом",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integrations",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit",
        "clients.view",
        "clients.create"
    ],
    "service_provider": "Module\\Crm\\HubSpotMigration\\HubSpotMigrationServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "hubspot-migration",
            "title": "Импорт из HubSpot",
            "route": "hubspot-migration",
            "icon": "upload-cloud",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/hubspot-migration.css"
        ],
        "js": [
            "web/assets/js/hubspot-migration.js"
        ]
    },
    "mcp_tools": [
        {
            "name": "hubspot_migration_status",
            "description": "Get HubSpot migration status, summary and staging statistics",
            "handler": "Module\\Crm\\HubSpotMigration\\Mcp\\MigrationStatusTool",
            "permissions": ["settings.view"],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "hubspot_migration_run",
            "description": "Trigger preflight dry-run or live batch import from HubSpot payload",
            "handler": "Module\\Crm\\HubSpotMigration\\Mcp\\MigrationRunTool",
            "permissions": ["settings.edit"],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "mode": {
                        "type": "string",
                        "enum": ["dry_run", "live_batch", "rollback"],
                        "description": "Execution mode"
                    },
                    "batch_size": {
                        "type": "integer",
                        "description": "Batch size for chunked execution (default 50)"
                    }
                },
                "required": ["mode"],
                "additionalProperties": false
            }
        }
    ]
}

{
    "name": "crm.dropbox",
    "version": "1.0.2",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Интеграция с Dropbox",
    "description": "Синхронизация файлов задач и проектов с Dropbox: автоматическая структура папок проектов, генерация временных и публичных shared links, поддержка курсоров list_folder",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit",
        "files.view",
        "files.create"
    ],
    "service_provider": "Module\\Crm\\Dropbox\\DropboxServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "dropbox-storage",
            "title": "Dropbox Хранилище",
            "route": "dropbox",
            "icon": "cloud-arrow-down",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/dropbox.css"
        ],
        "js": [
            "web/assets/js/dropbox.js"
        ]
    },
    "mcp_tools": [
        {
            "name": "dropbox_status",
            "description": "Get current connection status, account email and space usage on Dropbox",
            "handler": "Module\\Crm\\Dropbox\\Mcp\\DropboxStatusTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "dropbox_sync_project_files",
            "description": "Sync files of a project or task to a structured Dropbox folder and generate shared links",
            "handler": "Module\\Crm\\Dropbox\\Mcp\\SyncProjectFilesTool",
            "permissions": [
                "files.create"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "project_public_id": {
                        "type": "string",
                        "description": "Public ID of the CRM project"
                    },
                    "file_public_id": {
                        "type": "string",
                        "description": "Public ID of the CRM file to upload"
                    },
                    "visibility": {
                        "type": "string",
                        "enum": [
                            "public",
                            "team_only"
                        ],
                        "default": "public",
                        "description": "Shared link access level"
                    }
                },
                "required": [
                    "file_public_id"
                ],
                "additionalProperties": false
            }
        }
    ]
}
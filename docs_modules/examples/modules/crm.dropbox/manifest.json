{
    "name": "crm.dropbox",
    "version": "1.0.7",
    "vendor": "crm",
    "author": "Anton Barinov",
    "author_url": "https://github.com/Anton-Barinov",
    "title": "Интеграция с Dropbox",
    "description": "Подключение Dropbox через OAuth refresh token, безопасная передача файлов CRM в приватную папку и проверка аккаунта.",
    "core_version": ">=1.0.0",
    "license": "MIT",
    "category": "integration",
    "dependencies": [],
    "require_permissions": [
        "settings.view",
        "settings.edit",
        "files.view",
        "files.create"
    ],
    "service_provider": "Module\\Crm\\Dropbox\\DropboxServiceProvider",
    "migrations": "api/migrations",
    "api_routes": "api/config/routes.php",
    "web_routes": "web/config/routes.php",
    "menu_items": [
        {
            "id": "dropbox-storage",
            "title": "Dropbox Хранилище",
            "route": "dropbox",
            "icon": "cloud-arrow-down",
            "permission": "settings.edit"
        }
    ],
    "assets": {
        "css": [
            "web/assets/css/dropbox.css"
        ],
        "js_routes": {
            "module-dropbox": "web/assets/js/dropbox.js"
        }
    },
    "mcp_tools": [
        {
            "name": "dropbox_status",
            "description": "Report whether Dropbox is configured for the active workspace; never reveal stored credentials",
            "handler": "Module\\Crm\\Dropbox\\Mcp\\DropboxStatusTool",
            "permissions": [
                "settings.view"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
            }
        },
        {
            "name": "dropbox_sync_project_files",
            "description": "Upload an authorized CRM file to the active workspace Dropbox account without creating a public share link",
            "handler": "Module\\Crm\\Dropbox\\Mcp\\SyncProjectFilesTool",
            "permissions": [
                "files.view",
                "files.create"
            ],
            "mode": "all",
            "workspace_required": true,
            "input_schema": {
                "type": "object",
                "properties": {
                    "file_public_id": {
                        "type": "string",
                        "description": "Public ID of an accessible, non-quarantined CRM file to upload"
                    }
                },
                "required": [
                    "file_public_id"
                ],
                "additionalProperties": false
            }
        }
    ]
}

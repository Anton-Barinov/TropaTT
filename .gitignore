# Ignore everything in project root by default
/*

# Allow only these root directories
!/api/
!/modules/
!/web/
!/scripts

# Allow only these root files
!/AGENTS.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/index.php
!/LICENSE
!/README.md
!/ROADMAP.md
!/SECURITY.md
!/SUPPORT.md
!/phpstan.neon
!/phpstan-baseline.neon

# Allow .github directory (CI/CD workflows, issue templates, PR template)
!/.github/

!/.gitignore

# Allow storage_api .htaccess files for defense-in-depth access control.
# We ONLY permit these specific files — all other storage_api/ runtime files
# (SQLite DB, cache, dev-backups, update logs, uploads, etc.) must never be committed.
# The /* rule at top blocks everything in root, then we selectively whitelist.
!/storage_api/
/storage_api/**
!/storage_api/.htaccess
!/storage_api/secrets/
/storage_api/secrets/**
!/storage_api/secrets/.htaccess
!/storage_api/uploads/
/storage_api/uploads/**
!/storage_api/uploads/.htaccess

# Local one-click update runtime. Keep this deployable with the core,
# but do not ever allow private updater keys to be committed.



# Secrets, credentials, private keys — never upload

.env
.env.*
*.env
*.local
*.local.*

*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore


id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

*.pub
*.ppk

auth.json
credentials.json
service-account*.json
google-services.json
firebase*.json

secrets.*
secret.*
*.secret
*.secrets

config.local.php
*.local.php
*.private.php

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
api/docs/

# Temporary / converted JS files
web/assets/js/*.tmp*
web/assets/js/*.broken
web/assets/js/*.converted
web/assets/js/*.pre_tiny
web/assets/js/*.converted.js
web/assets/js/page-api-bindings.converted.js
web/assets/js/XX7FVWxB
web/assets/js/_i18n_replace2.pl
web/assets/js/i18n_convert.py



# AtomCode local-scope configs (machine-specific)
.atomcode/local/

# Deploy hash — runtime artifact generated by deploy.sh, never commit
web/DEPLOY_HASH

# Test runtime storage — local-only, never commit
api/storage_test_runtime/
.github/

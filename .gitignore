# Ignore everything in project root by default
/*

# Allow only these root directories
!/api/
!/modules/
!/web/

# Allow only these root files
!/AGENTS.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/index.php
!/LICENSE
!/README.md
!/ROADMAP.md
!/SECURITY.md
!/SUPPORT.md

!/.gitignore


# Secrets, credentials, private keys — never upload

.env
.env.*
*.env
*.local
*.local.*

*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore

id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

*.pub
*.ppk

auth.json
credentials.json
service-account*.json
google-services.json
firebase*.json

secrets.*
secret.*
*.secret
*.secrets

config.local.php
*.local.php
*.private.php

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
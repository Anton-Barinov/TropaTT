# Ignore everything in project root by default
/*

# Allow only these root directories
!/api/
!/docs/
!/modules/
!/web/
!/updater/

# Allow only these root files
!/AGENTS.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/index.php
!/LICENSE
!/README.md
!/ROADMAP.md
!/SECURITY.md
!/SUPPORT.md

!/.gitignore

# Local one-click update runtime. Keep this deployable with the core,
# but do not ever allow private updater keys to be committed.
!/updater/**
/updater/keys/*
/updater/**/*.key
/updater/**/*private*

# Public documentation
/docs/*
!/docs/maintainer/
!/docs/maintainer/**


# Secrets, credentials, private keys — never upload

.env
.env.*
*.env
*.local
*.local.*

*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore

!/updater/keys/update_public.pem

id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

*.pub
*.ppk

auth.json
credentials.json
service-account*.json
google-services.json
firebase*.json

secrets.*
secret.*
*.secret
*.secrets

config.local.php
*.local.php
*.private.php

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
api/docs/

# Temporary / converted JS files
web/assets/js/*.tmp*
web/assets/js/*.broken
web/assets/js/*.converted
web/assets/js/*.pre_tiny
web/assets/js/*.converted.js
web/assets/js/page-api-bindings.converted.js
web/assets/js/XX7FVWxB
web/assets/js/_i18n_replace2.pl
web/assets/js/i18n_convert.py


# Ignored generated/private documentation
/docs/api/
/docs/api/**
/docs/landing/
/docs/landing/**
/docs/web/
/docs/web/**

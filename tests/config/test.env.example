# Example environment config for the TropaTT API+MCP test suite.
# Copy to tests/config/test.env (git-ignored / not published) and fill in real values.
#
# BASE_URL: the running CRM API endpoint prefix, without trailing slash.
#   Usually: https://demo.tropatt.com/api/index.php?route=api/v1  (the API app entry)
#   so that the suite calls {BASE_URL}/tasks, {BASE_URL}/projects, etc.
#   For these tests we use the /api/index.php?route= route form because that is the
#   canonical path on the demo install (root index.php drops ?route=).
#
# AUTH:
#   Either provide TOKEN directly (an existing admin/root API access token), OR
#   provide LOGIN + PASSWORD so the suite logs in and obtains a token itself.
#   ADMIN creds are required to reach RBAC-level visibility. On the public demo this
#   is admin/adminadmin.
#
# TEST_DOMAIN_IS_DEMO: set "1" if BASE_URL points at a *.tropatt.com test domain.
#   Destructive/side-effect cases are allowed ONLY when this is 1.

BASE_URL=https://demo.tropatt.com/api/index.php?route=api/v1
MCP_URL=https://demo.tropatt.com/api/index.php?route=api/v1/mcp

# Provide one of the two auth styles:
TOKEN=
LOGIN=admin
PASSWORD=adminadmin

# Timeouts / retries
HTTP_TIMEOUT=20
REQUEST_RETRIES=1

# 1 = allow create/update/delete over test-created data on the target
TEST_DOMAIN_IS_DEMO=1
# SEC-001: Protect uploads directory — disable PHP execution, directory listing
# Apache 2.4+ compatibility
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 compatibility
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

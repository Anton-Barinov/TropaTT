parameters:
	ignoreErrors:
		-
			message: '#^Variable \$taskKeys in PHPDoc tag @var does not exist\.$#'
			identifier: varTag.variableNotFound
			count: 1
			path: api/controller/project/ProjectController.php

		-
			message: '#^Cannot call method where\(\) on int\.$#'
			identifier: method.nonObject
			count: 1
			path: api/model/task/TaskActivityRepository.php

		-
			message: '#^PHPDoc tag @return with type array\<int, string\> is incompatible with native type int\.$#'
			identifier: return.phpDocType
			count: 1
			path: api/model/template/TemplateRepository.php

		-
			message: '#^Method Api\\Model\\View\\SavedViewRepository\:\:list\(\) should return array\{items\: array, meta\: array\} but returns array\{items\: array\<int, array\<string, mixed\>\>, total\: int, page\: int\<1, max\>, limit\: int\<1, 100\>\}\.$#'
			identifier: return.type
			count: 1
			path: api/model/view/SavedViewRepository.php

		-
			message: '#^Call to an undefined method Api\\Model\\Common\\UserRepository\:\:findByCondition\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: api/system/library/app.php

		-
			message: '#^Parameter &\$tree by\-ref type of method Api\\System\\Library\\Module\\ModuleDependencyInstaller\:\:buildTree\(\) expects array\<string, array\<string\>\>, array\<string, array\<mixed\>\> given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: api/system/library/module/ModuleDependencyInstaller.php

		-
			message: '#^Method Api\\System\\Library\\Module\\ModuleGraphQLSchema\:\:buildResolvers\(\) should return array\<string, callable\(\)\: mixed\> but returns array\{Query\: non\-empty\-array\<string, callable\(\)\: mixed\>, Mutation\: array\{noop\: Closure\(\)\: true\}\}\.$#'
			identifier: return.type
			count: 1
			path: api/system/library/module/ModuleGraphQLSchema.php

		-
			message: '#^PHPDoc tag @var has invalid value \(array\<string, array\{start\: float, operations\: array\<string, array\{start\: float\}\>\>\}\)\: Unexpected token "\>", expected ''\}'' at offset 89 on line 1$#'
			identifier: phpDoc.parseError
			count: 1
			path: api/system/library/module/ModuleProfiler.php

		-
			message: '#^Access to an undefined property ZipArchive\:\:\$numEntries\.$#'
			identifier: property.notFound
			count: 1
			path: api/system/library/module/ModuleRemoteInstaller.php

		-
			message: '#^Method Api\\System\\Library\\Module\\PluginManager\:\:getModuleErrors\(\) should return array\<int, array\{code\: string, field\: string, message\: string, value\: mixed, rule\: string\}\>\|null but returns array\<string, array\{code\: string, field\: string, message\: string, value\: mixed, rule\: string\}\>\|null\.$#'
			identifier: return.type
			count: 1
			path: api/system/library/module/PluginManager.php

		-
			message: '#^Method Api\\System\\Library\\Module\\PluginManager\:\:getValidationErrors\(\) should return array\<string, array\<int, array\{code\: string, field\: string, message\: string, value\: mixed, rule\: string\}\>\> but returns array\<string, array\<string, array\{code\: string, field\: string, message\: string, value\: mixed, rule\: string\}\>\>\.$#'
			identifier: return.type
			count: 1
			path: api/system/library/module/PluginManager.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$error$#'
			identifier: parameter.notFound
			count: 1
			path: api/system/library/module/PluginManager.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$defaults$#'
			identifier: parameter.notFound
			count: 1
			path: api/system/library/service/AiRetentionPolicyService.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$actor$#'
			identifier: parameter.notFound
			count: 1
			path: api/system/library/service/AiSuggestionService.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$promptRuntime$#'
			identifier: parameter.notFound
			count: 1
			path: api/system/library/service/AiSuggestionService.php

		-
			message: '#^PHPDoc tag @return with type array\<string, mixed\> is incompatible with native type string\.$#'
			identifier: return.phpDocType
			count: 1
			path: api/system/library/service/AiSuggestionService.php

		-
			message: '#^PHPDoc tag @return with type array\<string, string\> is incompatible with native type bool\.$#'
			identifier: return.phpDocType
			count: 1

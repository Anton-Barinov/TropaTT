# Runtime mode
APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=Europe/Moscow

# Storage
CRM_STORAGE_BASE=/absolute/path/to/storage_api

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_api
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Security secrets (required in production)
APP_KEY=change-me-app-key
CSRF_SECRET_KEY=change-me-csrf-key
WEBHOOK_SECRET_KEY=change-me-webhook-key
AI_ENCRYPTION_KEY=change-me-ai-encryption-key
CRM_LOCAL_SECRET=change-me-local-secret

# CORS allowlist (comma-separated)
CORS_ALLOW_ORIGIN=https://localhost,http://localhost,https://127.0.0.1,http://127.0.0.1

# Optional install bootstrap secret
INSTALL_BOOTSTRAP_SECRET=

# Optional push gateway
NOTIFICATIONS_PUSH_GATEWAY_URL=
NOTIFICATIONS_PUSH_TIMEOUT_SEC=5
NOTIFICATIONS_PUSH_MAX_SUBSCRIPTIONS_PER_DISPATCH=100

# API File Cache (disabled by default)
API_FILE_CACHE_ENABLED=false
API_FILE_CACHE_TTL=60
API_FILE_CACHE_DEBUG=false

# API File Cache - Garbage Collection (enabled by default)
# Removes orphaned cache files older than GC_MAX_AGE seconds
# GC runs with probability 1/GC_PROBABILITY on each cache operation
# GC_LIMIT caps deletions per run to avoid IO spikes
API_FILE_CACHE_GC_ENABLED=true
API_FILE_CACHE_GC_PROBABILITY=1
API_FILE_CACHE_GC_MAX_AGE=86400
API_FILE_CACHE_GC_LIMIT=100

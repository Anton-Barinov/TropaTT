# SEC-009: Root-level .htaccess hardening.
# This file is deployed to public_html/ on the demo and to any installation's
# document root. It blocks direct access to sensitive files/directories that
# live at the project root (sibling of api/ and web/).
#
# Per-directory .htaccess files in api/ and web/ take precedence for requests
# to those paths, so this file only governs the root directory itself.

# Block all hidden files and directories at the root.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block direct access to sensitive top-level config and metadata files.
# Each entry is matched against the basename only (FilesMatch without a path
# applies to the directory the .htaccess lives in).
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|VERSION|LICENSE|README|CHANGELOG|ROADMAP|AGENTS|SECURITY|SUPPORT|CODE_OF_CONDUCT|CONTRIBUTING)(\.(md|lock|json|yaml|yml))?$">
    Require all denied
</FilesMatch>

# Block direct access to top-level directories that should never be web-served.
# /api/ and /web/ are allowed (and have their own .htaccess). /storage/,
# /storage_api/, /modules/, /scripts/, and /.git/ are not.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "^\.git(/|$)" - [F,L]
    RewriteRule "^storage(/|$)" - [F,L]
    RewriteRule "^storage_api(/|$)" - [F,L]
    RewriteRule "^scripts(/|$)" - [F,L]
    RewriteRule "^modules(/|$)" - [F,L]
</IfModule>
